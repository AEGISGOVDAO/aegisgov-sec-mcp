{
  "version": 2,
  "builds": [
    { "src": "api/*.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/mcp", "dest": "/api/mcp.js" },
    { "src": "/health", "dest": "/api/health.js" },
    { "src": "/", "dest": "/api/index.js" },
    { "src": "/.well-known/mcp.json", "dest": "/api/manifest.js" },
    { "src": "/company", "methods": ["POST"], "dest": "/api/company.js" },
    { "src": "/filings", "methods": ["POST"], "dest": "/api/filings.js" },
    { "src": "/financials", "methods": ["POST"], "dest": "/api/financials.js" },
    { "src": "/search", "methods": ["POST"], "dest": "/api/search.js" }
  ]
}
